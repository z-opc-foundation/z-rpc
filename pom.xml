    <!-- 消费入口统一走 z-boot-parent（1.0.19 起全组织口径，z-cache 试点量出来的那套步骤）：
         继承第三方地板 z-boot-dependencies（156 条）+ import 兄弟仓权威 z-boot-fleet（163 条）
         + Java 8 的 pluginManagement。迁移前这里**没有** <parent>（根 pom 自包含，
         io.github.yuku123:z-rpc:1.0.3 实测在 repo1 上），代价是版本格全靠本仓自己那张 11 键的属性表
         维护，与 fleet 的 z-rpc 1.0.3、地板的 netty 4.1.138.Final / protobuf-java 3.25.5 /
         slf4j 1.7.36 逐格重复，抬一格地板要 34 个仓跟着改。
         relativePath 必须留空：parent 不在磁盘上，在 repo1。 -->
    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-boot-parent</artifactId>
        <version>1.0.21</version>
        <relativePath/>
    </parent>


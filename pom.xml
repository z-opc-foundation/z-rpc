            <!-- 删掉条目、改由父链下发（面值与基线 tree 逐字相同，见上面 properties 那段注释）：
                 io.netty:netty-all（地板 netty-bom 4.1.138.Final）、
                 io.github.yuku123:z-util-core（fleet 1.0.13）、
                 com.google.protobuf:protobuf-java（地板 3.25.5）、
                 org.slf4j:slf4j-api（地板经 spring-boot-dependencies 2.7.18 给 1.7.36）。 -->

            <!-- 下面每一格都是"父链不供、或供得比基线低"，按坐标写**直接**条目顶住基线。
                 值来源：基线 dependency:tree（/tmp/zr-tree-head1.log）现算，不是抄的。 -->
            <!-- hessian / kryo：地板与 fleet 里 hessian 0 条、kryo 0 条。 -->
            <dependency>
                <groupId>com.caucho</groupId>
                <artifactId>hessian</artifactId>
                <version>${hessian.version}</version>
            </dependency>
            <dependency>
                <groupId>com.esotericsoftware</groupId>
                <artifactId>kryo</artifactId>
                <version>${kryo.version}</version>
            </dependency>
            <!-- objenesis：kryo 5.5.0 要 3.3，而地板直接钉的是 2.6（更低）⇒ 不顶住就是静默降大版本。
                 reflectasm 那格不用管：地板 1.11.9 与基线同值。 -->
            <dependency>
                <groupId>org.objenesis</groupId>
                <artifactId>objenesis</artifactId>
                <version>3.3</version>
            </dependency>
            <!-- log4j-api / log4j-core 是基线里的直接依赖（2.17.2），地板按坐标钉的是 **2.25.4** ⇒ 逐坐标写直接条目顶住。
                 log4j-to-slf4j 同样留着：基线里它是 spring-boot-starter-logging 带来的传递格（2.17.2），
                 而地板把 spring-boot-starter-logging 的 children 整批 exclude（`*:*`）⇒ 迁移后这一格与
                 jul-to-slf4j 一起从 starter 的 compile 图里消失（见 z-rpc-spring-boot-starter 里那条
                 logback-classic 的注释）。条目留着是把"它再出现时仍钉 2.17.2"写死，不是漏删。
                 log4j-jul / log4j-slf4j-impl 本仓 tree 里没有，不写。 -->
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-api</artifactId>

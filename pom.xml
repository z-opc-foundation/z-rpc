            <!-- jackson 四格：基线是 z-util-core 传递来的 2.18.9，地板 jackson-bom 是 2.18.6（更低）⇒ 顶住不掉。
                 这一族最终该由地板统一决定，本仓先在迁移里保住零漂移（与 z-cache 的 snakeyaml 同一处置）。 -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-annotations</artifactId>

    <properties>
        <!-- 删掉的键（parent_preflight 对 z-rpc 的第 2/5 节按**坐标**判过，面值与父链逐字相同 ⇒
             键与引用它的 <version> 一起删，改由父链下发）：
               netty.version=4.1.138.Final  → 地板 import io.netty:netty-bom 同值（基线 tree 32 件 io.netty 一件没动）
               spring-boot.version=2.7.18   → 地板 import spring-boot-dependencies 同值，而且本仓**没有任何一处引用这个键**
               z-rpc.version=1.0.3          → 自家坐标改钉 ${project.version}（见下面 DM）；fleet 那一格是 repo1 的旧发布件
               util.version=1.0.13          → 键名是全组织三种命名里的一种（z-util.version / util.version / zutil.version），
                                              按坐标看 fleet 供 io.github.yuku123:z-util-core 1.0.13 同值 ⇒ 删键删条目
               protobuf.version=3.25.5      → 地板按坐标供 com.google.protobuf:protobuf-java 3.25.5 同值；
                                              本仓基线 tree 里**没有** protobuf-java-util（z-vector 有那一格才必须留键），
                                              所以这里删掉不悬空
               slf4j.version=1.7.36         → 地板不直接钉 slf4j-api（只在 log4j-to-slf4j 里 exclude 它），
                                              走它 import 的 spring-boot-dependencies 2.7.18 = 1.7.36 同值
               maven.compiler.source/target=8、project.build.sourceEncoding=UTF-8 → parent 逐字同值下发
               reversion=1.0.1              → 全仓 0 处引用的死键，且与仓版本 1.0.3 自相矛盾 -->
        <!-- ⚠ compile.version 留着：父链没有这一格（它下发的是 maven.compiler.source/target），
             而下面 maven-compiler-plugin 的 <source>/<target> 用的就是它。删键=当场悬空。 -->
        <compile.version>8</compile.version>
        <!-- 序列化两格：地板里 hessian / kryo 各 0 条，父链完全没供给。 -->
        <hessian.version>4.0.66</hessian.version>
        <kryo.version>5.5.0</kryo.version>
        <!-- log4j2 必须留着自钉：地板按坐标把 log4j-api/core/to-slf4j 钉在 **2.25.4**，而本仓基线
             tree 是 2.17.2（core/remoting/starter 直接引的就是它）。这一格与 z-cache 试点同一口径：
             不是"随手沿用旧值"，是零漂移——抬 log4j 要连 Java 8 字节码与配置兼容一起验，不在迁移这一刀里顺手做。
             ⚠ 地板那几条是**直接** DM 条目，本仓的 import（这里没有 import）顶不过继承来的直接条目，
             所以只能也按坐标逐条写直接条目，见 README 步骤 5。 -->
        <log4j.version>2.17.2</log4j.version>
        <!-- junit 5.8.2：地板 import 的 junit-bom 是 5.9.3（junit-platform 1.9.3）。换测试框架版本
             会动到用例的发现与计数，不在迁移里顺手换 ⇒ 按坐标钉住基线。 -->
        <junit.version>5.8.2</junit.version>
    </properties>

